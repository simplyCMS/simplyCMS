# =============================================================================
# Змінні середовища магазину
# =============================================================================
# Скопіюйте цей файл у .env.local і заповніть значення:
#   cp .env.example .env.local
#
# 🔴 .env.local у git НЕ комітиться.
# 🔴 `pnpm owner:invite` (запрошення власника) читає звідси DATABASE_URL —
#    service_role-ключа Supabase він більше не потребує: запрошення
#    випускається прямо в Postgres (контракт v2).
# =============================================================================

# URL проєкту Supabase і публічний (publishable) ключ.
# Vite віддає в браузер лише змінні з префіксом VITE_ (import.meta.env).
# Взяти тут: Supabase Dashboard → Connect (або Project Settings → API Keys).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...your-publishable-key

# Legacy-запасний варіант: стара назва anon-ключа. Використовується, лише коли
# VITE_SUPABASE_PUBLISHABLE_KEY не заданий — для нових проєктів не потрібен.
# VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# Публічна адреса магазину. Потрібна для sitemap.xml і robots.txt.
VITE_SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Серверний контур (SERVER-ONLY, без префікса VITE_)
# -----------------------------------------------------------------------------
# 🔴 Ці ключі читаються ЛИШЕ з process.env і ЛИШЕ в рантаймі, тож їхня зміна
# потребує перезапуску процесу, а не перезбірки. Префікса VITE_ у них немає й
# бути не може: секрет підпису сесій у клієнтському бандлі — вже не секрет.

# Пряме підключення до Postgres. Логінитись треба РОЛЛЮ app_runtime: прямих
# грантів вона не має, тож забутий SET LOCAL ROLE падає, а не мовчки обходить RLS.
DATABASE_URL=postgresql://app_runtime:your-password@localhost:5432/postgres

# Секрет підпису сесій Better Auth. Згенерувати: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-byte-random-secret

# Публічна адреса застосунку — для посилань у листах. Необовʼязкова: без неї
# Better Auth виводить базу із самого запиту.
# BETTER_AUTH_URL=https://your-domain.com
