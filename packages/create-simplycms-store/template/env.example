# =============================================================================
# Змінні середовища магазину
# =============================================================================
# Скопіюйте цей файл у .env.local і заповніть значення:
#   cp .env.example .env.local
#
# 🔴 .env.local у git НЕ комітиться.
# 🔴 Обовʼязкових ключів рівно ТРИ. Браузер до бази не звертається, тож
#    креденшелів до неї не отримує. Опційні ключі йдуть групами драйверів за
#    правилом «все або нічого» (`simplycms/env`): частково задана група валить
#    старт і називає відсутні ключі.
# =============================================================================

# -----------------------------------------------------------------------------
# Серверний контур (SERVER-ONLY, без префікса VITE_)
# -----------------------------------------------------------------------------
# 🔴 Ці ключі читаються ЛИШЕ з process.env і ЛИШЕ в рантаймі, тож їхня зміна
# потребує перезапуску процесу, а не перезбірки. Префікса VITE_ у них немає й
# бути не може: секрет підпису сесій у клієнтському бандлі — вже не секрет.

# Пряме підключення до Postgres. Логінитись треба РОЛЛЮ app_runtime: прямих
# грантів вона не має, тож забутий SET LOCAL ROLE падає, а не мовчки обходить
# RLS. Звідси ж читає DATABASE_URL `pnpm owner:invite` (запрошення власника
# випускається прямо в Postgres).
# Формат: postgresql://app_runtime:<пароль>@<хост>:5432/<база>. Пароль ролі
# app_runtime накат міграцій синхронізує з цього URL.
# 🔴 КОЖЕН магазин має ВЛАСНИЙ екземпляр Postgres: ролі app_runtime/app_admin
# кластерні, тож у спільному кластері магазини ділять їх (docs/development/ENVIRONMENT.md).
DATABASE_URL=

# Секрет підпису сесій Better Auth. Згенерувати: openssl rand -base64 32
# 🔴 Порожній секрет магазин не стартує; готових прикладів значення тут немає навмисно.
BETTER_AUTH_SECRET=

# Публічна адреса застосунку — для посилань у листах і колбеків. Необовʼязкова:
# без неї база береться з origin `VITE_SITE_URL`, а коли немає обох — сервер не
# стартує (база з підробного Host була б відкритою діркою).
# BETTER_AUTH_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Клієнтський контур
# -----------------------------------------------------------------------------
# Публічна адреса магазину: sitemap.xml, robots.txt і посилання запрошення.
# Значення запікається в бандл на `vite build` — зміна потребує перезбірки.
# Це ORIGIN сайту: шлях і слеш у кінці ігноруються (посилання в листах і база
# Better Auth будуються від origin).
VITE_SITE_URL=https://your-domain.com

# Локаль збірки й листів (опційно, за замовчуванням uk-UA): uk-UA або en-US.
# Запікається при `vite build`; `pnpm owner:invite` бере мову листа звідси ж.
# VITE_LOCALE=uk-UA

# -----------------------------------------------------------------------------
# Сховище медіа (опційно) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Корінь драйвера `local-fs`: сюди лягають завантажені зображення, роздає їх
# роут ядра `/media/*`. Опційний — без нього магазин використовує
# `./.data/media` відносно робочої теки сервера.
#
# 🔴 У проді задай шлях, що переживає редеплой (mounted volume). Дефолт лежить
# усередині теки деплою, тож свіжий деплой стартував би з порожнім сховищем —
# і кожна завантажена картинка віддавала б 404.
# MEDIA_ROOT=/var/lib/simplycms/media

# -----------------------------------------------------------------------------
# Сховище S3 (опційно, все або нічого) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Усі пʼять ключів разом перемикають драйвер медіа з `local-fs` на `s3`; часткова
# група валить старт і називає відсутні ключі. Коли група задана, `MEDIA_ROOT`
# вище ігнорується (старт друкує одне попередження).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket
# Ключ і секрет видає сховище (кожному застосунку — свій бакет і своя пара).
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# -----------------------------------------------------------------------------
# Пошта SMTP (опційно, все або нічого) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Обидва ключі разом перемикають драйвер пошти з `log` на `smtp`. `SMTP_URL`
# несе пароль — не друкуй його ніде.
# Формат SMTP_URL: smtps://<користувач>:<пароль>@<хост>:465 (дані дає поштовий сервіс).
# SMTP_URL=
# MAIL_FROM=Your Store <shop@example.com>

# -----------------------------------------------------------------------------
# Накат міграцій на старті (опційно) — SERVER-ONLY
# -----------------------------------------------------------------------------
# `MIGRATION_DATABASE_URL` — зʼєднання власника БД, яке бачать лише
# `pnpm simplycms db:apply` і `scripts/start.mjs`: вони накочують міграції
# (start.mjs — до старту сервера). Сам сервер цієї
# змінної не має; `DATABASE_URL` лишається роллю `app_runtime`.
# Формат: postgresql://<власник схеми>:<пароль>@<хост>:5432/<база>.
# MIGRATION_DATABASE_URL=
