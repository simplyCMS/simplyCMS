{
  "name": "@simplycms/plugin-faq",
  "version": "0.4.0",
  "private": false,
  "description": "Reference FAQ plugin for SimplyCMS built with @simplycms/plugin-sdk: plg_faq_items table (migration in-package), /admin/faq CRUD routes, product-detail slot, Zod settings, uk/en i18n catalog.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./routes/*": "./routes/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./pages/*": {
        "types": "./dist/pages/*.d.ts",
        "import": "./dist/pages/*.js"
      },
      "./routes/*": "./routes/*"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "routes",
    "migrations",
    "!src/**/__tests__/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/simplycms-plugin-faq"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "simplycms": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "simplycms": "workspace:*"
  }
}
