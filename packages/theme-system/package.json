{
  "name": "@simplycms/themes",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ThemeRegistry": "./src/ThemeRegistry.ts",
    "./ThemeContext": "./src/ThemeContext.tsx",
    "./applyTokens": "./src/applyTokens.ts",
    "./validateThemeModule": "./src/validateThemeModule.ts",
    "./useThemeT": "./src/useThemeT.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ThemeRegistry": {
        "types": "./dist/ThemeRegistry.d.ts",
        "import": "./dist/ThemeRegistry.js"
      },
      "./ThemeContext": {
        "types": "./dist/ThemeContext.d.ts",
        "import": "./dist/ThemeContext.js"
      },
      "./applyTokens": {
        "types": "./dist/applyTokens.d.ts",
        "import": "./dist/applyTokens.js"
      },
      "./validateThemeModule": {
        "types": "./dist/validateThemeModule.d.ts",
        "import": "./dist/validateThemeModule.js"
      },
      "./useThemeT": {
        "types": "./dist/useThemeT.d.ts",
        "import": "./dist/useThemeT.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/theme-system"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@simplycms/i18n": "workspace:*",
    "@simplycms/objects": "workspace:*",
    "@simplycms/supabase": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
