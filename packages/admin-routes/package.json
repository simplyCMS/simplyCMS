{
  "name": "@simplycms/admin-routes",
  "version": "0.2.1",
  "private": false,
  "description": "Admin route-компоненти для SimplyCMS (фізичні файли, підключаються через virtualRouteConfig)",
  "type": "module",
  "exports": {
    "./routes/*": "./routes/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      "./routes/*": "./routes/*"
    }
  },
  "files": [
    "routes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/admin-routes"
  },
  "dependencies": {
    "@simplycms/admin": "workspace:*",
    "@simplycms/storefront-routes": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
