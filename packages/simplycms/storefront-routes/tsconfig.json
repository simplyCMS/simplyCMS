{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": false,
    "outDir": "./dist",
    "declarationDir": "./dist",
    // Пакет читає `import.meta.env` — типи дає vite/client (build-time only).
    "types": ["vite/client", "node"],
    // ЛИШЕ для емісії .d.ts: у standalone-програмі пакета немає host-ового
    // `routeTree.gen.ts` з `declare module '@tanstack/react-router'`, тому
    // колбеки роутера (`navigate({ search: (s) => … })`) лишаються без
    // контекстного типу. Повний strict по ЦИХ САМИХ файлах лишається за
    // кореневим `pnpm typecheck` — гейт не послаблено.
    "noImplicitAny": false
  },
  "include": ["src"]
}
