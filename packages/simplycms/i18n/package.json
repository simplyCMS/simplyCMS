{
  "name": "@simplycms/i18n",
  "version": "0.1.0",
  "private": false,
  "description": "Request-scoped i18n for SimplyCMS: uk/en catalogs, translator factory and React provider (no global mutable state)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/simplycms/i18n"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
