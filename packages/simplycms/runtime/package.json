{
  "name": "@simplycms/runtime",
  "version": "0.1.0",
  "private": false,
  "description": "SimplyCMS engine runtime (Tier 6): defineConfig wires adapters/modules/theme/plugins into an EngineContext.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplySOFTua/simplyCMS-core.git",
    "directory": "runtime"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@simplycms/objects": "workspace:*"
  }
}
