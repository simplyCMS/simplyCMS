{
  "name": "@simplycms/schema",
  "version": "0.1.0",
  "private": false,
  "description": "Drizzle-baseline схеми SimplyCMS: таблиці, енами та RLS-політики в TypeScript",
  "type": "module",
  "main": "./src/schema.ts",
  "types": "./src/schema.ts",
  "exports": {
    ".": "./src/schema.ts",
    "./relations": "./src/relations.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "main": "./dist/schema.js",
    "types": "./dist/schema.d.ts",
    "exports": {
      ".": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      },
      "./relations": {
        "types": "./dist/relations.d.ts",
        "import": "./dist/relations.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/simplycms/schema"
  },
  "scripts": {
    "db:pull": "drizzle-kit pull --config ./drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:dump-rls": "node ./scripts/dump-rls.mjs",
    "build": "tsup"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "pg": "8.22.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  }
}
