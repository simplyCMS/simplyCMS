{
  // Емісія ВСІХ .d.ts пакета — дешевим tsc замість dts-плагіна бандлера.
  //
  // 🔴 Причина — не смак, а виміряний баг вендореного rollup-plugin-dts
  // (розтин 2026-08-24): він створює окрему повну ts.Program на КОЖНУ теку
  // entry профілю (несталий dirName на cache-hit у getCompilerOptions) і
  // тримає їх усі живими до кінця збірки. 228 entry профілю tiers у 34 теках
  // давали 36 програм → 191 с / 9 ГБ там, де tsc робив ту саму роботу за
  // ~26 с / 1.1 ГБ (усе — вимір 2026-08-24). Вартість масштабується кількістю ТЕК, а не entry чи
  // складністю типів. Перевірено ще раз 2026-09-02 на tsdown: одна програма
  // на пакет, але OOM 3 ГБ за 25 с; tsc — 11 с / 1,1 ГБ. Деталі й бюджет —
  // docs/architecture/test-contours.md, розділ «Бюджет памʼяті після tsdown».
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "./dist",
    "declarationDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "skipLibCheck": true,
    "incremental": false
  },
  "include": ["src"],
  // 🔴 Без exclude d.ts тестів поїхали б у tarball (dist/**/__tests__/).
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
