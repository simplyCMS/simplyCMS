{
  "name": "@simplycms/objects",
  "version": "0.3.0",
  "private": false,
  "description": "Headless commerce object contracts and ports for SimplyCMS engine (Tier 0). Zero runtime dependencies; the only runtime code is the semver micro-utility (engines.simplycms checks).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./objects": "./src/objects/index.ts",
    "./ports": "./src/ports/index.ts",
    "./semver": "./src/semver/index.ts",
    "./views": "./src/views/index.ts",
    "./views/fixtures": "./src/views/fixtures/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./objects": {
        "types": "./dist/objects/index.d.ts",
        "import": "./dist/objects/index.js"
      },
      "./ports": {
        "types": "./dist/ports/index.d.ts",
        "import": "./dist/ports/index.js"
      },
      "./semver": {
        "types": "./dist/semver/index.d.ts",
        "import": "./dist/semver/index.js"
      },
      "./views": {
        "types": "./dist/views/index.d.ts",
        "import": "./dist/views/index.js"
      },
      "./views/fixtures": {
        "types": "./dist/views/fixtures/index.d.ts",
        "import": "./dist/views/fixtures/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/objects"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
