{
  "name": "@simplycms/domain",
  "version": "0.1.0",
  "private": false,
  "description": "Pure commerce domain logic for SimplyCMS engine (Tier 1): pricing, discounts, inventory, shipping. No IO, no supabase, no react.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pricing": "./src/pricing.ts",
    "./discounts": "./src/discounts.ts",
    "./inventory": "./src/inventory.ts",
    "./shipping": "./src/shipping.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./pricing": {
        "types": "./dist/pricing.d.ts",
        "import": "./dist/pricing.js"
      },
      "./discounts": {
        "types": "./dist/discounts.d.ts",
        "import": "./dist/discounts.js"
      },
      "./inventory": {
        "types": "./dist/inventory.d.ts",
        "import": "./dist/inventory.js"
      },
      "./shipping": {
        "types": "./dist/shipping.d.ts",
        "import": "./dist/shipping.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/domain"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@simplycms/objects": "workspace:*"
  }
}
