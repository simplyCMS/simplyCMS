{
  "name": "@simplycms/plugin-sdk",
  "version": "0.3.0",
  "private": false,
  "description": "Plugin SDK for SimplyCMS: definePlugin contract, module validation, plugin i18n and plg_* data port. The only surface a plugin is allowed to import (Tier 2).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/plugin-sdk"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@simplycms/i18n": "workspace:*",
    "@simplycms/objects": "workspace:*",
    "@simplycms/plugins": "workspace:*",
    "@simplycms/supabase": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  }
}
