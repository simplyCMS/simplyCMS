{
  "name": "@simplycms/theme-solarstore",
  "version": "0.3.0",
  "private": false,
  "description": "Reference SimplyCMS theme (contract v2): manifest, design tokens, Header/Footer/HeroBanner/HomeSections components and a uk/en message catalog for an alternative-energy storefront.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/simplycms-theme-solarstore"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@simplycms/core": "workspace:*",
    "simplycms": "workspace:*",
    "@simplycms/themes": "workspace:*",
    "@simplycms/ui": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
