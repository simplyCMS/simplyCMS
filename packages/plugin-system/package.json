{
  "name": "@simplycms/plugins",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./PluginSlot": {
      "types": "./src/PluginSlot.tsx",
      "import": "./src/PluginSlot.tsx",
      "default": "./src/PluginSlot.tsx"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./PluginSlot": {
        "types": "./dist/PluginSlot.d.ts",
        "import": "./dist/PluginSlot.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/plugin-system"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@simplycms/objects": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
