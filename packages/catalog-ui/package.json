{
  "name": "@simplycms/catalog-ui",
  "version": "0.2.1",
  "private": false,
  "description": "Catalog UI for SimplyCMS — presentational components + containers for the product catalog (filters, product cards, gallery, stock, modifications). Feature-ui split package (P7).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplyCMS/simplyCMS.git",
    "directory": "packages/catalog-ui"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@simplycms/supabase": "workspace:*",
    "@simplycms/core": "workspace:*",
    "@simplycms/ui": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
