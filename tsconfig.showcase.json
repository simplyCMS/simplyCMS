{
  // Типізація сіду вітрини (`scripts/showcase/*.mts`, `pnpm db:showcase`).
  //
  // 🔴 Навіщо окремий конфіг. `tsx` типів не перевіряє, а кореневий
  // `tsconfig.json` включає `**/*.ts` — `.mts` у цей глоб не потрапляє. Без
  // цього гейта сід міг би розійтися з сигнатурами ядер, яких він кличе, і
  // це спливло б лише на живому прогоні. Ті самі `paths` і `strict` —
  // через `extends` кореня: сід імпортує ядро відносними шляхами на `src`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Інкрементний кеш кореня (`tsconfig.tsbuildinfo`) не ділимо: дві
    // програми з різним `include` перезаписували б його одна одній.
    "incremental": false
  },
  "include": ["scripts/showcase/**/*.mts"]
}
