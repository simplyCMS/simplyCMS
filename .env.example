# =============================================================================
# SimplyCMS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to git!
#
# 🔴 The store's env contract is exactly THREE keys (0.4.1): one client-side
# (`VITE_SITE_URL`) and two server-side. Supabase keys are gone — the browser
# never talks to the database, so it has no credentials for it either.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Direct Postgres connection: the pool behind `simplycms/db` opens it at
# runtime. Log in as the `app_runtime` role: it holds no direct grants, so a
# forgotten `SET LOCAL ROLE` fails closed instead of silently bypassing RLS.
# The same URL is the source for tooling (`db:pull`, `db:diff`).
#
# 🔴 Read from `process.env` ONLY, and only at runtime (server env contract,
# CLI spec §7) — rotating it means restarting the process, not rebuilding.
DATABASE_URL=postgresql://app_runtime:your-password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# Better Auth — серверний auth-контур v2 (`simplycms/auth`) — SERVER-ONLY
# -----------------------------------------------------------------------------
# 🔴 No `VITE_` prefix here, and there cannot be one: a session-signing secret
# inside the client bundle is not a secret. Required together with
# DATABASE_URL — without them the server throws loudly instead of silently
# letting anyone in (`/api/auth/*`, the admin guard in `src/start.ts`).
#
# Session/token signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-byte-random-secret
#
# Public base URL of the app — used for OAuth callbacks and links in emails.
# Optional: without it Better Auth derives the base from the request itself,
# which is enough for the email+password flow.
# BETTER_AUTH_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Site (required for production) — client-side
# -----------------------------------------------------------------------------
# Public URL of the deployed site. Used for sitemap.xml and robots.txt.
# `VITE_` means "visible to the client": the value is baked in at `vite build`,
# so changing it needs a rebuild, unlike the two server keys above.
VITE_SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# PG-харнес для `pnpm test:schema` (optional, dev-only)
# -----------------------------------------------------------------------------
# Гейт `test:schema` працює проти ОКРЕМОГО локального Postgres — не проти бази
# магазину вище. Задай готовий кластер (напр. той самий образ, що й у CI
# service-контейнері) — інакше гейт сам піднімає ефемерний initdb+pg_ctl
# кластер і гасить його по собі (потребує непривілейованого юзера postgres —
# від root initdb падає).
# PG_HARNESS_URL=postgresql://pgtest@127.0.0.1:55432/postgres
