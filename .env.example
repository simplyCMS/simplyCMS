# =============================================================================
# SimplyCMS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to git!
#
# 🔴 The store has exactly THREE required keys (0.4.1): one client-side
# (`VITE_SITE_URL`) and two server-side. The browser never talks to the
# database, so it has no database credentials either. Optional keys come in
# driver groups, "all or nothing" (`simplycms/env`): a partially set group
# fails the start with the names of the missing keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Direct Postgres connection: the pool behind `simplycms/db` opens it at
# runtime. Log in as the `app_runtime` role: it holds no direct grants, so a
# forgotten `SET LOCAL ROLE` fails closed instead of silently bypassing RLS.
# The same URL is the source for tooling (`db:pull`, `db:diff`).
#
# 🔴 Read from `process.env` ONLY, and only at runtime (server env contract,
# CLI spec §7) — rotating it means restarting the process, not rebuilding.
DATABASE_URL=postgresql://app_runtime:your-password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# Better Auth — серверний auth-контур v2 (`simplycms/auth`) — SERVER-ONLY
# -----------------------------------------------------------------------------
# 🔴 No `VITE_` prefix here, and there cannot be one: a session-signing secret
# inside the client bundle is not a secret. Required together with
# DATABASE_URL — without them the server throws loudly instead of silently
# letting anyone in (`/api/auth/*`, the admin guard in `src/start.ts`).
#
# Session/token signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-byte-random-secret
#
# Public base URL of the app — used for OAuth callbacks and links in emails.
# Optional in dev: without it Better Auth derives the base from the request
# (the startup WARN "Base URL is not set" is expected). Recommended in prod:
# with a string baseURL Better Auth trusts EXACTLY that origin and rejects
# others with 403 INVALID_ORIGIN — set it to the origin browsers really use.
# BETTER_AUTH_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Site (required for production) — client-side
# -----------------------------------------------------------------------------
# Public URL of the deployed site. Used for sitemap.xml and robots.txt.
# `VITE_` means "visible to the client": the value is baked in at `vite build`,
# so changing it needs a rebuild, unlike the two server keys above.
VITE_SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Media storage (optional) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Root directory of the `local-fs` media driver: uploaded images live here and
# are served by the core route `/media/*`. Optional — without it the store uses
# `./.data/media` relative to the server's working directory.
#
# 🔴 Set it in production to a path that survives redeploys (a mounted volume).
# The default lives inside the deploy directory, so a fresh deploy would start
# with an empty store and every uploaded image would 404.
# MEDIA_ROOT=/var/lib/simplycms/media

# -----------------------------------------------------------------------------
# S3 storage (optional, all or nothing) — SERVER-ONLY
# -----------------------------------------------------------------------------
# All five keys together switch the media driver from `local-fs` to `s3`; a
# partial group fails the start and names the missing keys. With the group set,
# `MEDIA_ROOT` above is ignored (the start prints one warning).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# -----------------------------------------------------------------------------
# SMTP mail (optional, all or nothing) — SERVER-ONLY
# -----------------------------------------------------------------------------
# Both keys together switch the mail driver from `log` to `smtp`. `SMTP_URL`
# carries the password — never print it.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Your Store <shop@example.com>

# -----------------------------------------------------------------------------
# Migrations on start (optional) — SERVER-ONLY
# -----------------------------------------------------------------------------
# `MIGRATION_DATABASE_URL` — owner-level connection used only by
# `pnpm simplycms db:apply` and `scripts/start.mjs` to apply migrations (the
# latter before the server starts). The server
# process itself never sees it; `DATABASE_URL` stays the `app_runtime` role.
# MIGRATION_DATABASE_URL=postgresql://owner:password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# PG-харнес для `pnpm test:schema` (optional, dev-only)
# -----------------------------------------------------------------------------
# Гейт `test:schema` працює проти ОКРЕМОГО локального Postgres — не проти бази
# магазину вище. Задай готовий кластер (напр. той самий образ, що й у CI
# service-контейнері) — інакше гейт сам піднімає ефемерний initdb+pg_ctl
# кластер і гасить його по собі (потребує непривілейованого юзера postgres —
# від root initdb падає).
# PG_HARNESS_URL=postgresql://pgtest@127.0.0.1:55432/postgres
