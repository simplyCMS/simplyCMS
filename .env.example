# =============================================================================
# SimplyCMS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Supabase project URL and publishable (public) key.
# Vite exposes client-side vars via the VITE_ prefix (import.meta.env).
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...your-publishable-key

# Legacy fallback: the old anon-key naming. Used only when
# VITE_SUPABASE_PUBLISHABLE_KEY is not set — prefer the publishable key above.
# VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# Supabase project ref — used for type generation and migrations.
# Get from: https://supabase.com/dashboard/project/_/settings/general
SUPABASE_PROJECT_ID=your-project-ref

# Supabase personal access token — used for Management API (types, migrations).
# Generate at: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxx

# (Optional) Database password — used for supabase link. If not set, the
# script will link without validating DB settings.
# SUPABASE_DB_PASSWORD=your-db-password

# Direct Postgres connection (session pooler) — used only for db:pull,
# db:diff and db:dump-rls. Not needed for db:migrate/db:generate-types
# (those go through the Management API above).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Site (required for production)
# -----------------------------------------------------------------------------
# Public URL of the deployed site. Used for sitemap.xml and robots.txt.
VITE_SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Revalidation (optional)
# -----------------------------------------------------------------------------
# Secret token for on-demand ISR revalidation via POST /api/revalidate.
# Generate a random string: openssl rand -hex 32
REVALIDATION_SECRET=your-revalidation-secret

# -----------------------------------------------------------------------------
# Supabase Edge Functions (auto-injected by Supabase, no manual setup needed)
# -----------------------------------------------------------------------------
# These are automatically available inside Supabase Edge Functions runtime.
# Listed here for documentation purposes only — do NOT set them manually.
# SUPABASE_URL=          (auto-injected)
# SUPABASE_SERVICE_ROLE_KEY= (auto-injected)
