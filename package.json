    "lint:fix": "pnpm exec eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:template": "tsc -p tsconfig.template.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
