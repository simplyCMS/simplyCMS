  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "dev:www": "pnpm --filter simplycms-www dev",
    "build:www": "pnpm --filter simplycms-www build",
    "typecheck:www": "pnpm --filter simplycms-www typecheck",
    "build:packages": "pnpm --filter \"@simplycms/*\" --filter simplycms run build",
