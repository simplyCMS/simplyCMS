    "db:pull": "pnpm --filter simplycms run db:pull",
    "db:dump-rls": "pnpm --filter simplycms run db:dump-rls",
    "db:diff": "node scripts/db-diff.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
