{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    "paths": {
      "@simplycms/objects": ["./packages/objects/src"],
      "@simplycms/objects/*": ["./packages/objects/src/*"],
      "@simplycms/domain": ["./packages/domain/src"],
      "@simplycms/domain/*": ["./packages/domain/src/*"],
      "@simplycms/data-supabase": ["./packages/data-supabase/src"],
      "@simplycms/data-supabase/*": ["./packages/data-supabase/src/*"],
      "@simplycms/supabase": ["./packages/supabase/src"],
      "@simplycms/supabase/*": ["./packages/supabase/src/*"],
      "@simplycms/storefront-routes": ["./packages/storefront-routes/src"],
      "@simplycms/storefront-routes/*": ["./packages/storefront-routes/src/*"],
      "@simplycms/i18n": ["./packages/i18n/src"],
      "@simplycms/i18n/*": ["./packages/i18n/src/*"],
      "@simplycms/runtime": ["./packages/runtime/src"],
      "@simplycms/runtime/*": ["./packages/runtime/src/*"],
      "@simplycms/react-query": ["./packages/react-query/src"],
      "@simplycms/react-query/*": ["./packages/react-query/src/*"],
      "@simplycms/storefront": ["./packages/storefront/src"],
      "@simplycms/storefront/*": ["./packages/storefront/src/*"],
      "@simplycms/cart-ui": ["./packages/cart-ui/src"],
      "@simplycms/cart-ui/*": ["./packages/cart-ui/src/*"],
      "@simplycms/catalog-ui": ["./packages/catalog-ui/src"],
      "@simplycms/catalog-ui/*": ["./packages/catalog-ui/src/*"],
      "@simplycms/checkout-ui": ["./packages/checkout-ui/src"],
      "@simplycms/checkout-ui/*": ["./packages/checkout-ui/src/*"],
      "@simplycms/profile-ui": ["./packages/profile-ui/src"],
      "@simplycms/profile-ui/*": ["./packages/profile-ui/src/*"],
      "@simplycms/reviews-ui": ["./packages/reviews-ui/src"],
      "@simplycms/reviews-ui/*": ["./packages/reviews-ui/src/*"],
      "@simplycms/core": ["./packages/core/src"],
      "@simplycms/core/*": ["./packages/core/src/*"],
      "@simplycms/admin": ["./packages/admin/src"],
      "@simplycms/admin/*": ["./packages/admin/src/*"],
      "@simplycms/ui": ["./packages/ui/src"],
      "@simplycms/ui/*": ["./packages/ui/src/*"],
      "@simplycms/plugins": ["./packages/plugin-system/src"],
      "@simplycms/plugins/*": ["./packages/plugin-system/src/*"],
      "@simplycms/themes": ["./packages/theme-system/src"],
      "@simplycms/themes/*": ["./packages/theme-system/src/*"],
      "@themes/*": ["./themes/*"],
      "@plugins/*": ["./plugins/*"]
    },
    "baseUrl": "."
  },
  "include": ["src", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "temp",
    "tools",
    "supabase/functions",
    "vitest.config.ts",
    "**/tsup.config.ts",
    "**/dist",
    "tests/pilot/store-template",
    "packages/create-simplycms-store/template",
    "packages/cli/host"
  ]
}
