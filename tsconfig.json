{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    "paths": {
      "@simplysoftua/db-types": [
        "./supabase/types.ts"
      ],
      "@simplysoftua/objects": [
        "./packages/simplycms/objects/src"
      ],
      "@simplysoftua/objects/*": [
        "./packages/simplycms/objects/src/*"
      ],
      "@simplysoftua/domain": [
        "./packages/simplycms/domain/src"
      ],
      "@simplysoftua/domain/*": [
        "./packages/simplycms/domain/src/*"
      ],
      "@simplysoftua/data-supabase": [
        "./packages/simplycms/data-supabase/src"
      ],
      "@simplysoftua/data-supabase/*": [
        "./packages/simplycms/data-supabase/src/*"
      ],
      "@simplysoftua/runtime": [
        "./packages/simplycms/runtime/src"
      ],
      "@simplysoftua/runtime/*": [
        "./packages/simplycms/runtime/src/*"
      ],
      "@simplysoftua/react-query": [
        "./packages/simplycms/react-query/src"
      ],
      "@simplysoftua/react-query/*": [
        "./packages/simplycms/react-query/src/*"
      ],
      "@simplysoftua/storefront": [
        "./packages/simplycms/storefront/src"
      ],
      "@simplysoftua/storefront/*": [
        "./packages/simplycms/storefront/src/*"
      ],
      "@simplysoftua/cart-ui": [
        "./packages/simplycms/cart-ui/src"
      ],
      "@simplysoftua/cart-ui/*": [
        "./packages/simplycms/cart-ui/src/*"
      ],
      "@simplysoftua/catalog-ui": [
        "./packages/simplycms/catalog-ui/src"
      ],
      "@simplysoftua/catalog-ui/*": [
        "./packages/simplycms/catalog-ui/src/*"
      ],
      "@simplysoftua/checkout-ui": [
        "./packages/simplycms/checkout-ui/src"
      ],
      "@simplysoftua/checkout-ui/*": [
        "./packages/simplycms/checkout-ui/src/*"
      ],
      "@simplysoftua/profile-ui": [
        "./packages/simplycms/profile-ui/src"
      ],
      "@simplysoftua/profile-ui/*": [
        "./packages/simplycms/profile-ui/src/*"
      ],
      "@simplysoftua/reviews-ui": [
        "./packages/simplycms/reviews-ui/src"
      ],
      "@simplysoftua/reviews-ui/*": [
        "./packages/simplycms/reviews-ui/src/*"
      ],
      "@simplysoftua/core": [
        "./packages/simplycms/core/src"
      ],
      "@simplysoftua/core/*": [
        "./packages/simplycms/core/src/*"
      ],
      "@simplysoftua/admin": [
        "./packages/simplycms/admin/src"
      ],
      "@simplysoftua/admin/*": [
        "./packages/simplycms/admin/src/*"
      ],
      "@simplysoftua/ui": [
        "./packages/simplycms/ui/src"
      ],
      "@simplysoftua/ui/*": [
        "./packages/simplycms/ui/src/*"
      ],
      "@simplysoftua/plugins": [
        "./packages/simplycms/plugin-system/src"
      ],
      "@simplysoftua/plugins/*": [
        "./packages/simplycms/plugin-system/src/*"
      ],
      "@simplysoftua/themes": [
        "./packages/simplycms/theme-system/src"
      ],
      "@simplysoftua/themes/*": [
        "./packages/simplycms/theme-system/src/*"
      ],
      "@themes/*": [
        "./themes/*"
      ],
      "@plugins/*": [
        "./plugins/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "temp",
    "tools",
    "supabase/functions",
    "vitest.config.ts",
    "**/tsup.config.ts",
    "**/dist"
  ]
}
