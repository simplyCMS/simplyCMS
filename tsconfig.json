{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,

    "paths": {
      "@simplycms/storefront-routes": ["./packages/storefront-routes/src"],
      "@simplycms/storefront-routes/*": ["./packages/storefront-routes/src/*"],
      "@simplycms/cart-ui": ["./packages/cart-ui/src"],
      "@simplycms/cart-ui/*": ["./packages/cart-ui/src/*"],
      "@simplycms/catalog-ui": ["./packages/catalog-ui/src"],
      "@simplycms/catalog-ui/*": ["./packages/catalog-ui/src/*"],
      "@simplycms/checkout-ui": ["./packages/checkout-ui/src"],
      "@simplycms/checkout-ui/*": ["./packages/checkout-ui/src/*"],
      "@simplycms/profile-ui": ["./packages/profile-ui/src"],
      "@simplycms/profile-ui/*": ["./packages/profile-ui/src/*"],
      "@simplycms/reviews-ui": ["./packages/reviews-ui/src"],
      "@simplycms/reviews-ui/*": ["./packages/reviews-ui/src/*"],
      "@simplycms/core": ["./packages/core/src"],
      "@simplycms/core/*": ["./packages/core/src/*"],
      "@simplycms/admin": ["./packages/admin/src"],
      "@simplycms/admin/*": ["./packages/admin/src/*"],
      "@simplycms/ui": ["./packages/ui/src"],
      "@simplycms/ui/*": ["./packages/ui/src/*"],
      "@simplycms/plugins": ["./packages/plugin-system/src"],
      "@simplycms/plugins/*": ["./packages/plugin-system/src/*"],
      "@simplycms/plugin-sdk": ["./packages/plugin-sdk/src"],
      "@simplycms/plugin-sdk/*": ["./packages/plugin-sdk/src/*"],
      "@simplycms/plugin-faq": ["./packages/simplycms-plugin-faq/src"],
      "@simplycms/plugin-faq/pages/*": [
        "./packages/simplycms-plugin-faq/src/pages/*"
      ],
      "@simplycms/plugin-faq/*": ["./packages/simplycms-plugin-faq/src/*"],
      "@simplycms/themes": ["./packages/theme-system/src"],
      "@simplycms/themes/*": ["./packages/theme-system/src/*"],
      "@simplycms/theme-solarstore": [
        "./packages/simplycms-theme-solarstore/src"
      ],
      "simplycms": ["./packages/simplycms/src"],
      "simplycms/*": ["./packages/simplycms/src/*"],
      "@themes/*": ["./themes/*"],
      "@plugins/*": ["./plugins/*"]
    },
    "baseUrl": "."
  },
  "include": ["src", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "temp",
    "tools",
    "supabase/functions",
    "vitest.config.ts",
    "**/tsup.config.ts",
    "**/dist",
    "tests/pilot/store-template",
    "packages/create-simplycms-store/template",
    "packages/cli/host",
    "apps/www"
  ]
}
